# --- Server ---
PORT=8101
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Scraper ---
COURIER_URL=https://courierbox.sistemaml.info/index.php?accesscheck=%2Fjc_home.php
COURIER_USER=
COURIER_PASS=
SCRAPER_TIMEOUT_MS=60000
CACHE_TTL_SECONDS=60

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- Mongo ---
DB_URI=mongodb://localhost:27017/courierbox

# --- CourierBridge: Contifico (facturación SRI) ---
# CONTIFICO_API_KEY=
# CONTIFICO_TOKEN=
# CONTIFICO_API_URL=https://api.contifico.com/v1
# CONTIFICO_PUNTO_EMISION=001
# CONTIFICO_ESTABLECIMIENTO=001

# --- CourierBridge: GHL Webhooks ---
# GHL_WEBHOOK_INVOICE_URL=https://your-ghl-workflow-url.com/webhook

# --- Cloudinary (subida de comprobantes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
